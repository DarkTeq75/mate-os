Window.SetBackgroundTopColor(0.08, 0.08, 0.08);
Window.SetBackgroundBottomColor(0.08, 0.08, 0.08);

text = Image.Text("Mate!_OS", 1, 1, 1);
text_sprite = Sprite(text);

bar_width = 400;
bar_height = 8;

function refresh_callback() {
    progress = Plymouth.GetBootProgress();

    if (progress < 0) progress = 0;
    if (progress > 1) progress = 1;

    text_sprite.SetPosition(
        Window.GetWidth() / 2 - text.GetWidth() / 2,
        Window.GetHeight() / 2 - 50
    );

    bar_image = Image(bar_width * progress, bar_height);
    bar_sprite = Sprite(bar_image);

    bar_sprite.SetPosition(
        Window.GetWidth() / 2 - bar_width / 2,
        Window.GetHeight() / 2 + 20
    );
}

Plymouth.SetRefreshFunction(refresh_callback);
